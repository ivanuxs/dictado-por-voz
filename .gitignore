# ─────────────────────────────────────────────────────────────
# Entornos virtuales (nunca versionar: son específicos de cada PC)
# ─────────────────────────────────────────────────────────────
entorno_web/
.venv/
venv/
env/
ENV/

# ─────────────────────────────────────────────────────────────
# Modelos de voz y de traducción (Opus-MT convertidos a CTranslate2, ~80 MB
# cada uno). Se generan con puente_web/herramientas/preparar_modelos.py.
# Las licencias SÍ se versionan (modelos/LICENCIAS.md).
# ─────────────────────────────────────────────────────────────
*.model
puente_web/modelos/*
!puente_web/modelos/LICENCIAS.md

# Base de datos de cuentas del puente (correos, hashes de contraseñas y uso).
# NO se versiona nunca.
puente_web/datos/

# ─────────────────────────────────────────────────────────────
# Logs y archivos temporales de la aplicación
# ─────────────────────────────────────────────────────────────
logs/
*.log

# ─────────────────────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ─────────────────────────────────────────────────────────────
# Secretos y configuración local (NUNCA subir claves)
# ─────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
puente-web.env

# Clave del proxy incrustada al compilar (la generan
# cliente_ubuntu/empaquetado/compilar_en_contenedor.sh y
# cliente_windows/preparar_clave.py desde clave_proxy.txt o
# DICTADO_PUENTE_CLAVE).
clave_proxy_compilada.py
# Clave del proxy en texto, para que viaje con la carpeta a la PC Windows
# (la lee construir_exe_windows.bat y también el cliente en ejecución).
clave_proxy.txt
# Versión del cliente: la escribe el empaquetado (Docker en Ubuntu, 
# crear_instalador.bat en Windows) y la lee el propio cliente.
version.txt

# ─────────────────────────────────────────────────────────────
# Compilación del cliente Android
# ─────────────────────────────────────────────────────────────
cliente_android/.gradle/
cliente_android/build/
cliente_android/app/build/
cliente_android/local.properties
# Lista original del diccionario: se descarga sola con generar_diccionario.py
cliente_android/herramientas/es_50k.txt
*.apk
*.aab

# ─────────────────────────────────────────────────────────────
# Cliente de escritorio (Ubuntu y Windows)
# ─────────────────────────────────────────────────────────────

# Entorno virtual del cliente Ubuntu (se recrea con requirements.txt).
entorno_dictado/

# Modelos Vosk antiguos (2,3 GB). El cliente ya usa faster-whisper.
vosk-model-es/

# Artefactos de la compilación con Nuitka y resultados del empaquetado.
cliente_ubuntu/empaquetado/salida/
cliente_ubuntu/empaquetado/.construccion/

# Registros del cliente Ubuntu (rotados).
cliente_ubuntu/logs/

# Compilación del cliente Windows con PyInstaller.
cliente_windows/build/
cliente_windows/dist/
*.exe
*.deb

# Instalador de Windows generado con Inno Setup.
cliente_windows/instalador/salida/

# Carpetas de trabajo y respaldos de código retirado.
scratch/
resguardos/

# ─────────────────────────────────────────────────────────────
# Carpetas y archivos de herramientas de editor / asistentes
# ─────────────────────────────────────────────────────────────
.qwen/
.vscode/
.idea/
*.swp
*~

# ─────────────────────────────────────────────────────────────
# Sistema operativo
# ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# Historial de herramientas de diseño (Open Design).
.open-design/
