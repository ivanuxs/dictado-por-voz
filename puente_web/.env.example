# Plantilla de configuración del puente web.
#
# La copia real vive FUERA del repositorio (es público):
#     cp puente_web/.env.example ~/.config/puente-web.env
#     chmod 600 ~/.config/puente-web.env
#
# Generar el token con:  openssl rand -hex 32

# Token que deben presentar los clientes (cabecera Authorization: Bearer).
# Sin esto el puente se niega a arrancar.
DICTADO_WEB_TOKEN=CAMBIAR_POR_UN_TOKEN_LARGO

# Token del servidor de dictado (solo si su unidad define DICTADO_TOKEN).
#DICTADO_ZMQ_TOKEN=

# Dirección del servidor de dictado (por defecto, el mismo equipo).
#DICTADO_ZMQ=tcp://127.0.0.1:5555

# Escucha del puente. 0.0.0.0 para que lo alcance el nginx de la red local;
# el firewall decide quién puede entrar.
#DICTADO_PUENTE_HOST=0.0.0.0
#DICTADO_PUENTE_PUERTO=8000

# Límites que protegen la GPU (6 GB, compartida con el dictado y los lotes).
#DICTADO_MAX_SEGUNDOS=60
#DICTADO_MAX_MB=5
#DICTADO_CONCURRENTES=2
#DICTADO_ESPERA_MAXIMA=30
#DICTADO_TIMEOUT=120
