# Plantilla de configuración del puente web.
#
# La copia real vive FUERA del repositorio (es público):
#     cp puente_web/.env.example ~/.config/puente-web.env
#     chmod 600 ~/.config/puente-web.env
#
# Generar el token con:  openssl rand -hex 32

# Token que deben presentar los clientes (cabecera Authorization: Bearer).
# Es el TOKEN MAESTRO: lo usan los clientes de escritorio y los scripts del
# dueño. Ya no es la única entrada: las cuentas de la app entran con su propio
# token (ver más abajo). Si se deja vacío, solo entran las cuentas.
DICTADO_WEB_TOKEN=CAMBIAR_POR_UN_TOKEN_LARGO

# Token del servidor de dictado (solo si su unidad define DICTADO_TOKEN).
#DICTADO_ZMQ_TOKEN=

# Dirección del servidor de dictado (por defecto, el mismo equipo).
#DICTADO_ZMQ=tcp://127.0.0.1:5555

# Escucha del puente. 0.0.0.0 para que lo alcance el nginx de la red local;
# el firewall decide quién puede entrar.
#DICTADO_PUENTE_HOST=0.0.0.0
#DICTADO_PUENTE_PUERTO=8000

# Límites que protegen la GPU (6 GB, compartida con el dictado y los lotes).
#DICTADO_MAX_SEGUNDOS=60
#DICTADO_MAX_MB=5
#DICTADO_CONCURRENTES=2
#DICTADO_ESPERA_MAXIMA=30
#DICTADO_TIMEOUT=120

# ---------------------------------------------------------------------------
# Traducción (Opus-MT en CPU, DENTRO del puente: no toca el servidor de dictado)
# Los modelos se generan con herramientas/preparar_modelos.py.
# ---------------------------------------------------------------------------
#DICTADO_TRADUCCION=1
#DICTADO_MODELOS=/ruta/a/puente_web/modelos
#DICTADO_MAX_CARACTERES=2000
#DICTADO_HILOS_TRADUCCION=2
# Cuántos modelos de traducción se quedan en memoria (~300 MB cada uno).
#DICTADO_MODELOS_EN_MEMORIA=6

# ---------------------------------------------------------------------------
# Cuentas de usuario
#
# El registro está ABIERTO a propósito: la app se publica en Google Play y
# cualquiera que la descargue tiene que poder crearse su cuenta. La base lleva
# correos y hashes: NO se versiona (ver .gitignore → puente_web/datos/).
# ---------------------------------------------------------------------------
#DICTADO_DATOS=/ruta/a/puente_web/datos
#DICTADO_BD=/ruta/a/puente_web/datos/usuarios.db
#DICTADO_REGISTRO=abierto
#DICTADO_PLAN_POR_DEFECTO=gratis
#DICTADO_TOKEN_DIAS=365

# --- Correo para confirmar la cuenta (Gmail o SMTP propio) ------------------
#
# Gmail:  host smtp.gmail.com, puerto 587, TLS starttls y, como clave, una
#         CONTRASEÑA DE APLICACIÓN (16 letras; exige verificación en dos pasos
#         en la cuenta de Google). La contraseña normal de Gmail NO sirve.
# Propio: el host y el puerto del servidor, con TLS starttls (587) o ssl (465).
#
# Si no se pone nada, el registro sigue funcionando pero SIN verificar el
# correo (modo pruebas): el puente lo avisa al arrancar.
#DICTADO_SMTP_HOST=smtp.gmail.com
#DICTADO_SMTP_PUERTO=587
#DICTADO_SMTP_USUARIO=tucuenta@gmail.com
#DICTADO_SMTP_CLAVE=aaaaaaaaaaaaaaaa
#DICTADO_SMTP_TLS=starttls
#DICTADO_SMTP_DE=
# Forzar la verificación (1) o desactivarla (0); vacío = la que toque según SMTP.
#DICTADO_VERIFICAR_CORREO=
#DICTADO_CODIGO_MINUTOS=30
