<?xml version="1.0" encoding="utf-8"?>
<!--
  Estructura del teclado, en UNA sola pantalla:
    - arriba, la banda de dictado (estado + portapapeles + micrófono grande)
      -> vista_dictado.xml
    - debajo, la barra de sugerencias y el teclado de letras (en código)
  Ya no hay dos modos que se sustituyan: se dicta y se escribe a la vez.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/fondo_teclado"
    android:orientation="vertical"
    android:padding="6dp">

    <include
        layout="@layout/vista_dictado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Vertical para poder poner la barra de sugerencias ENCIMA del teclado. -->
    <LinearLayout
        android:id="@+id/contenedor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>
