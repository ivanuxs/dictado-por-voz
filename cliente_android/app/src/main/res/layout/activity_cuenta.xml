<?xml version="1.0" encoding="utf-8"?>
<!--
  Pantalla de cuenta: entrar, crear cuenta, confirmar el correo y ver el plan.

  Está separada de Ajustes a propósito: así la pantalla de ajustes (que ya
  funciona y está probada) solo gana un botón, y todo lo de cuentas vive aquí.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Cabecera: el mismo monograma que en Ajustes, para que las dos
             pantallas se lean como una sola app. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/fondo_logo"
                android:gravity="center"
                android:text="@string/app_monograma"
                android:textColor="@color/texto_sobre_acento"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                style="@style/TituloPantalla"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/cuenta_titulo" />
        </LinearLayout>

        <TextView
            android:id="@+id/texto_cuenta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp"
            android:text="@string/cuenta_sin_sesion"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp" />

        <!-- Sin sesión: entrar o crear cuenta. -->
        <LinearLayout
            android:id="@+id/bloque_entrar"
            style="@style/Tarjeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <TextView
                style="@style/EtiquetaAjuste"
                android:text="@string/cuenta_usuario" />

            <EditText
                android:id="@+id/campo_usuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="username"
                android:hint="@string/cuenta_usuario_ayuda"
                android:inputType="text"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurfaceVariant" />

            <TextView
                style="@style/EtiquetaAjuste"
                android:text="@string/cuenta_correo" />

            <EditText
                android:id="@+id/campo_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="emailAddress"
                android:hint="@string/cuenta_correo_ayuda"
                android:inputType="textEmailAddress"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurfaceVariant" />

            <TextView
                style="@style/EtiquetaAjuste"
                android:text="@string/cuenta_contrasena" />

            <EditText
                android:id="@+id/campo_contrasena"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="password"
                android:hint="@string/cuenta_contrasena_ayuda"
                android:inputType="textPassword"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurfaceVariant" />

            <EditText
                android:id="@+id/campo_codigo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/cuenta_codigo"
                android:inputType="number"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />

            <Button
                android:id="@+id/boton_verificar"
                style="@style/BotonPrincipal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/cuenta_verificar"
                android:visibility="gone" />

            <Button
                android:id="@+id/boton_entrar"
                style="@style/BotonPrincipal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/cuenta_entrar" />

            <Button
                android:id="@+id/boton_crear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cuenta_crear" />
        </LinearLayout>

        <!-- Con sesión: plan, cupos de hoy y salida. -->
        <LinearLayout
            android:id="@+id/bloque_cuenta"
            style="@style/Tarjeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/texto_plan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp" />

            <Button
                android:id="@+id/boton_sincronizar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/cuenta_sincronizar" />

            <Button
                android:id="@+id/boton_actualizar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/cuenta_actualizar" />

            <Button
                android:id="@+id/boton_salir"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cuenta_salir" />

            <Button
                android:id="@+id/boton_borrar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cuenta_borrar" />
        </LinearLayout>

        <!-- El catálogo es público: se puede mirar con o sin sesión. -->
        <Button
            android:id="@+id/boton_planes"
            style="@style/BotonTenue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/cuenta_planes" />

        <TextView
            android:id="@+id/texto_resultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textIsSelectable="true"
            android:textSize="13sp" />

        <Button
            android:id="@+id/boton_volver"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/cuenta_volver" />
    </LinearLayout>
</ScrollView>
