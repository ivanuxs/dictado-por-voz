<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Paleta oscura del teclado (rediseño del 2026-11-15).
         Tres niveles de superficie, no dos: fondo (lo más profundo), teclas de
         letras y teclas de función. Los tonos son más profundos que antes
         (#121417 → #0B0D0F) para que el acento verde-teal se lea como LUZ y no
         como otro gris. Las teclas siguen planas y pegadas: el aire sale de la
         banda, la barra de sugerencias y las pantallas, no de las letras. -->
    <color name="fondo_teclado">#FF0B0D0F</color>
    <color name="superficie">#FF12161A</color>
    <color name="fondo_boton">#FF1A2026</color>
    <color name="fondo_boton_pulsado">#FF2F3941</color>
    <color name="fondo_especial">#FF242C33</color>
    <color name="fondo_especial_pulsado">#FF39434B</color>
    <!-- ⇧/⇪ encendido: verde-teal tenue. -->
    <color name="tecla_activa">#FF1B3B39</color>

    <!-- Rótulos: claro en las letras, atenuado en las teclas de función.
         El secundario sube de contraste (#9AA5AF → #93A1A9 sobre fondos más
         oscuros: 6.5:1) para que las ayudas se lean sin forzar la vista. -->
    <color name="texto_tecla">#FFE9EFF2</color>
    <color name="texto_tecla_secundario">#FF93A1A9</color>
    <color name="texto_estado">#FF93A1A9</color>
    <color name="texto_error">#FFFF8A7A</color>

    <!-- Acento verde-teal: ⇧ activo, ↵, punto de estado y micrófono listo.
         El tono tenue es su versión de relleno (fondo del ↵ y del micrófono) y
         `texto_sobre_acento` es el que garantiza contraste encima del acento. -->
    <color name="acento">#FF4FD1C5</color>
    <color name="acento_tenue">#FF1B3B39</color>
    <color name="texto_sobre_acento">#FF06201E</color>
    <color name="icono">#FFFFFFFF</color>

    <!-- Micrófono: verde-teal profundo con borde de acento en reposo; rojo y
         ámbar sólidos mientras graba o transcribe. -->
    <color name="micro_listo">#FF1B3B39</color>
    <color name="micro_grabando">#FFFF6B5A</color>
    <color name="micro_procesando">#FFF5A524</color>
    <color name="micro_error">#FF2F3941</color>

    <!-- Contorno de la barra espaciadora (la única tecla con borde). -->
    <color name="borde_espacio">#26FFFFFF</color>

    <!-- Franja de sugerencias y portapapeles. -->
    <color name="fondo_sugerencias">#FF101418</color>
    <color name="fondo_sugerencia_pulsada">#FF242C33</color>
    <color name="portapapeles_fondo">#FF151A1F</color>
    <color name="portapapeles_borde">#1FFFFFFF</color>
    <color name="separador">#14FFFFFF</color>

    <!-- Pantallas de la app (ajustes y cuenta): tarjetas y campos. -->
    <color name="tarjeta">#FF151A20</color>
    <color name="tarjeta_borde">#14FFFFFF</color>
    <color name="campo_fondo">#FF0F1418</color>
    <color name="campo_borde">#1FFFFFFF</color>
</resources>
