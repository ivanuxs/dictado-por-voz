<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo de un botón pequeño (ajustes, traducir, portapapeles, historial,
     estrella, papelera, ✕). Antes era transparente y el botón solo aparecía al
     tocarlo: se perdía y no invitaba a pulsarlo. Ahora lleva el mismo relleno que
     una tecla de función y esquinas de 10dp, con el aclarado de siempre al
     pulsarlo. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/fondo_sugerencia_pulsada" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/fondo_boton" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
