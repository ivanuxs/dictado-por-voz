<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo de un botón pequeño (icono de historial, estrella, papelera, ✕).
     Transparente en reposo y aclarado con esquinas suaves al tocarlo, para que
     se vea que responde. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/fondo_sugerencia_pulsada" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
