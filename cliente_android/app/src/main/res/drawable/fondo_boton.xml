<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo de las teclas: se aclara mientras la tecla está pulsada, así el
     toque se ve al instante y no parece que haya retardo. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:drawable="@drawable/forma_tecla_pulsada" />
    <item android:drawable="@drawable/forma_tecla_normal" />
</selector>
