<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo del icono adaptativo: degradado de verde profundo (arriba a la
     izquierda) al casi negro del teclado (abajo a la derecha). Antes era un
     cuadrado verde plano. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:endColor="#FF0E1113"
        android:startColor="#FF1F5C3E"
        android:type="linear" />
</shape>
