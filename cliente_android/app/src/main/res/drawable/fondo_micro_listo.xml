<?xml version="1.0" encoding="utf-8"?>
<!-- Micrófono en reposo: rectángulo de 12dp (el mismo radio que los botones de
     al lado) en verde-teal profundo con contorno de acento. Se sigue
     reconociendo como el botón de voz por el color, la forma y el tamaño; la
     píldora de antes lo hacía parecer de otra familia. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/micro_listo" />
    <stroke
        android:width="1.5dp"
        android:color="@color/acento" />
    <corners android:radius="12dp" />
</shape>
