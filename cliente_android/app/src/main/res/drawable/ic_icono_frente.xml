<?xml version="1.0" encoding="utf-8"?>
<!-- Primer plano del icono adaptativo: una TECLA (cuadro de esquinas suaves en
     verde-teal) con el micrófono oscuro dentro. Antes era un anillo fino con el
     micrófono blanco: se perdía en el cajón de apps a tamaño pequeño.

     El lienzo es de 108x108 y la tecla mide 44dp, así que su diagonal (62dp)
     cabe en la zona segura (círculo de 66dp del centro) que Android recorta. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- La tecla. -->
    <path
        android:fillColor="@color/acento"
        android:pathData="M45,32h18a13,13 0 0 1 13,13v18a13,13 0 0 1 -13,13h-18a13,13 0 0 1 -13,-13v-18a13,13 0 0 1 13,-13z" />

    <!-- El micrófono, en el tono oscuro que va sobre el acento. -->
    <group
        android:scaleX="1.25"
        android:scaleY="1.25"
        android:translateX="39"
        android:translateY="39.6">
        <path
            android:fillColor="@color/texto_sobre_acento"
            android:pathData="M12,14c1.66,0 3,-1.34 3,-3V5c0,-1.66 -1.34,-3 -3,-3S9,3.34 9,5v6C9,12.66 10.34,14 12,14zM17,11c0,2.76 -2.24,5 -5,5s-5,-2.24 -5,-5H5c0,3.53 2.61,6.43 6,6.92V21h2v-3.08c3.39,-0.49 6,-3.39 6,-6.92H17z" />
    </group>
</vector>
