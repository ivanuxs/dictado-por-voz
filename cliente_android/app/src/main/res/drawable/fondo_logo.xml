<?xml version="1.0" encoding="utf-8"?>
<!-- Monograma de la cabecera: cuadro de acento con esquinas de 11dp. El texto
     va encima en `texto_sobre_acento` (oscuro), nunca en blanco: sobre el
     verde-teal el blanco no llega al contraste mínimo. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/acento" />
    <corners android:radius="11dp" />
</shape>
