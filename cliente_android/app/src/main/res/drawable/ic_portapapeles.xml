<?xml version="1.0" encoding="utf-8"?>
<!--
  Portapapeles: tablero ancho con la pinza arriba y tres renglones dentro.

  El de antes era una tabla estrecha (8 de ancho por 17 de alto) con un
  rectángulo pequeño encima y, en el botón, se leía como una PILA o una
  batería. Lo que lo hace inconfundible son los renglones: sin ellos, cualquier
  caja con un saliente arriba parece otra cosa.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Tablero (solo contorno, para que se vea el fondo del teclado). -->
    <path
        android:pathData="M9,4.5 H6.5 A1.5,1.5 0 0 0 5,6 V19.5 A1.5,1.5 0 0 0 6.5,21 H17.5 A1.5,1.5 0 0 0 19,19.5 V6 A1.5,1.5 0 0 0 17.5,4.5 H15"
        android:strokeColor="@color/icono"
        android:strokeLineCap="round"
        android:strokeWidth="1.8" />
    <!-- Pinza de arriba, ancha y centrada. -->
    <path
        android:fillColor="@color/icono"
        android:pathData="M9,2.2 H15 A1.3,1.3 0 0 1 16.3,3.5 V5.2 A1.3,1.3 0 0 1 15,6.5 H9 A1.3,1.3 0 0 1 7.7,5.2 V3.5 A1.3,1.3 0 0 1 9,2.2 Z" />
    <!-- Renglones: lo que se lee como «aquí hay texto copiado». -->
    <path
        android:pathData="M8.2,10 H15.8"
        android:strokeColor="@color/icono"
        android:strokeLineCap="round"
        android:strokeWidth="1.6" />
    <path
        android:pathData="M8.2,13.4 H15.8"
        android:strokeColor="@color/icono"
        android:strokeLineCap="round"
        android:strokeWidth="1.6" />
    <path
        android:pathData="M8.2,16.8 H13"
        android:strokeColor="@color/icono"
        android:strokeLineCap="round"
        android:strokeWidth="1.6" />
</vector>
