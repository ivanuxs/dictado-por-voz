<?xml version="1.0" encoding="utf-8"?>
<!-- Tecla de función ENCENDIDA (⇧ de una letra o ⇪ fijas). Es el único estado
     que no existía: el glifo cambiaba de ⇧ a ⇪, pero el fondo seguía igual y no
     se sabía si las mayúsculas estaban puestas. Verde tenue con el contorno de
     acento, en la misma línea plana del resto del teclado. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/tecla_activa" />
    <stroke
        android:width="1dp"
        android:color="@color/acento" />
</shape>
