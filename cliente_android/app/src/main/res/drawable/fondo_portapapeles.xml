<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo de la franja del portapapeles, encima del teclado. Lleva un borde
     tenue para separarla del fondo del teclado, que ahora es más profundo. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/portapapeles_fondo" />
    <stroke
        android:width="1dp"
        android:color="@color/portapapeles_borde" />
    <corners android:radius="10dp" />
</shape>
