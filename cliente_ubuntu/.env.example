# ─────────────────────────────────────────────────────────────
# Plantilla de variables de entorno
#
# Uso:
#   1. Copia este archivo como  .env   (o como  cliente-voz.env )
#   2. Coloca tu clave real
#   3. NO subas el archivo con la clave al repositorio:
#      .gitignore ya excluye  .env  y  cliente-voz.env
# ─────────────────────────────────────────────────────────────

# Clave de la API de DeepSeek (opcional).
# Si no se define, el asistente solo responde los comandos simples
# predefinidos (hora, fecha, saludos, etc.).
DEEPSEEK_API_KEY=

# Dirección del servidor de transcripción (IP:PUERTO).
# También se puede fijar con  --servidor IP:PUERTO  o en el campo
# "servidor" de comandos.json
DICTADO_SERVIDOR=127.0.0.1:5555
