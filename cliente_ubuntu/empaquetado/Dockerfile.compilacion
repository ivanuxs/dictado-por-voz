# Imagen de compilación del cliente de dictado (Ubuntu 22.04).
#
# Se usa 22.04 A PROPÓSITO: el binario enlaza contra la glibc de la imagen, y
# lo compilado en una versión vieja corre en las nuevas (22.04 → 24.04 → 25.x),
# pero no al revés. No cambiar la base sin querer dejar fuera a 22.04.
#
# Uso (lo hace `construir_binario.sh`, no hace falta a mano):
#   docker build -t skipkey-compilador:22.04 -f Dockerfile.compilacion .
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    CCACHE_DIR=/ccache

# - Python 3.10 (el de 22.04) + cabeceras y compilador para Nuitka.
# - `python3-tk` para las ventanas Tkinter (REC y Configuración).
# - `python3-gi`, `python3-gi-cairo` y `python3-dbus`: la bandeja y el botón
#   del auricular. Van en la imagen para que Nuitka los compile DENTRO del
#   binario; en la máquina destino solo quedan las librerías .so (apt).
# - `patchelf`, que Nuitka usa para arreglar el RPATH de los binarios.
# - `gir1.2-vte-2.91`: el plugin de PyGObject de Nuitka pide ese typelib al
#   analizar `gi`; sin él la compilación aborta con «Typelib ... 'Vte' not found».
# NO se instala ffmpeg a propósito: hace falta en la máquina destino (ffplay
# para el TTS), no para compilar, y son ~300 MB de imagen para nada.
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 \
        python3-venv \
        python3-dev \
        python3-pip \
        python3-tk \
        python3-gi \
        python3-gi-cairo \
        python3-dbus \
        gir1.2-gtk-3.0 \
        gir1.2-ayatanaappindicator3-0.1 \
        gir1.2-vte-2.91 \
        libayatana-appindicator3-1 \
        libgtk-3-0 \
        libdbus-1-3 \
        build-essential \
        ccache \
        patchelf \
        xz-utils \
        squashfs-tools \
        curl \
        file \
        zlib1g-dev \
        libffi-dev \
        libssl-dev \
        libbz2-dev \
        liblzma-dev \
        ca-certificates \
        tar \
    && rm -rf /var/lib/apt/lists/*

# appimagetool, para el AppImage. Es a su vez un AppImage y dentro del
# contenedor no hay FUSE: el script lo ejecuta con --appimage-extract-and-run.
RUN curl -fsSL -o /usr/local/bin/appimagetool \
        https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-x86_64.AppImage \
    && chmod +x /usr/local/bin/appimagetool

# ⚠️ patchelf DEL SISTEMA (0.14 en 22.04) CORROMPE las librerías de numpy:
# al reescribirles el RPATH quedan «ELF load command address/offset not
# page-aligned» y `import numpy` muere. La 0.18 respeta la alineación. Se
# instala en /usr/local/bin, que va antes en el PATH, así que es la que usa
# Nuitka. (Probado el 2026-11-18; sin esto el paquete arranca y revienta.)
RUN pip3 install --no-cache-dir "patchelf==0.18.0" \
    && /usr/local/bin/patchelf --version

WORKDIR /tmp

CMD ["/bin/bash"]
